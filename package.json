{
  "name": "runlet",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "turbo dev",
    "infra:up": "docker compose -f infra/compose.dev.yaml up -d --wait",
    "infra:down": "docker compose -f infra/compose.dev.yaml down",
    "typecheck": "turbo typecheck",
    "lint": "bun --bun oxlint --deny-warnings",
    "lint:fix": "bun --bun oxlint --fix",
    "fmt": "bun --bun oxfmt",
    "fmt:check": "bun --bun oxfmt --check",
    "check": "pnpm typecheck && pnpm lint && pnpm fmt:check",
    "test": "turbo test"
  },
  "devDependencies": {
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:"
  },
  "engines": {
    "bun": "1.4.4",
    "pnpm": "12.11.2"
  },
  "packageManager": "pnpm@12.11.2"
}
